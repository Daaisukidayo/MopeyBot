{
  "name": "MopeyBot",
  "version": "4.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "nodemon",
    "eslint": "eslint ./src --fix",
    "prettier": "prettier --write \"./src/**/*\"",
    "lint": "eslint ./src && prettier --check \"./src/**/*\"",
    "tidy": "npm run eslint && npm run prettier && npm run lint && npm run build"
  },
  "imports": {
    "#commandsData": "./dist/utils/getCommandsData.js"
  },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@quoriel/edge": "https://codeload.github.com/quoriel/edge/tar.gz/3ebcb96803c2b8422515d56da40030e6f65c9cd2",
    "@tryforge/forge.canvas": "^1.3.1",
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forge.topgg": "https://codeload.github.com/tryforge/forgetopgg/tar.gz/645de9e5802ed7b5bbb2157e584df5bde97925ee",
    "@tryforge/forgescript": "^2.7.1",
    "better-sqlite3": "^12.5.0",
    "forge.json": "^1.1.1",
    "forge.regex": "https://codeload.github.com/xNickyDev/ForgeRegex/tar.gz/2544fc6fdc523406db309d158928b6b679206d0e",
    "forge.timers": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
