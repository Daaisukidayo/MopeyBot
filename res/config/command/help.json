{
  "helpCategories": ["help_category_economy", "help_category_fun", "help_category_special", "help_category_luckchallenge"],

  "helpReplacements": [
    ["{PREFIX}", "$getPrefix"],
    ["{MAX_PARTICIPANTS}", "$getGlobalVar[maxLobbyParticipants]"],
    ["{BRACKETS_INFO}", "$codeBlock[$arrayJoin[$tl[data.bracketsInfo.$get[l]];\n]]"],
    ["{PUMPKINS_RARITIES}", "$codeBlock[$arrayJoin[$tl[data.pumpkinRarities.$get[l]];\n];JSON]"],
    ["{BEACHBALLS_RARITIES}", "$codeBlock[$arrayJoin[$tl[data.beachballRarities.$get[l]];\n];JSON]"],
    ["{UMBRELLAS_RARITIES}", "$codeBlock[$arrayJoin[$tl[data.umbrellaRarities.$get[l]];\n];JSON]"],
    ["{HYPERLINK_TIMEZONES}", "$hyperlink[List of all timezones;https://en.wikipedia.org/wiki/List_of_tzdatabase_time_zones]"],
    ["{EMOJI}", "$getGlobalVar[mopecoin]"],
    ["{MAX_COINFLIP_BET}", "$separate[$getGlobalVar[maxCoinflipBet]]"],
    ["{MAX_SLOTS_BET}", "$separate[$getGlobalVar[maxSlotsBet]]"],
    ["{MIN_SLOTS_BET}", "$separate[$getGlobalVar[defaultSlotsBet]]"],
    ["{AVAILABLE_LOCALES}", "$codeBlock[$arrayFormat[$jsonEntries[$getGlobalVar[allLocales]];{0} - {1};;;\n];MD]"],
    ["{ROLL_HISTORY_LENGTH}", "$getGlobalVar[rollHistoryLength]"],
    ["{HOF_MIN_CHANCE}", "$arrayMap[$getGlobalVar[rollGames];game;$return[$jsonGet[$getGlobalVar[hallOfFameMinChance];$env[game]]];hofChances]$separate[$min[$spread[$arrayJoin[hofChances;,];,]]]"],
    ["{HL_DIFFICULTIES}","$codeBlock[$arrayJoin[$arrayMap[$getGlobalVar[difficulties];d;$return[$tl[data.difficulties.$env[d].$get[l]]]];\n];JSON]"]
